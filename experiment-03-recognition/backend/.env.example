# 配置模板。复制为 backend/.env 或直接导出同名环境变量。
APP_ENV=development
# 生产必须覆盖，长度 >= 32 字节
JWT_SECRET=dev-insecure-jwt-secret-change-me
ACCESS_TOKEN_TTL_S=1800
REFRESH_TOKEN_TTL_S=604800
# 新设备首次登录的引导密钥；生产必须覆盖
DEVICE_SECRET=dev-device-secret-change-me
# SQLite 开发库路径（默认 backend/data/app.db）
DB_PATH=backend/data/app.db
# 模型元数据与下载文件
MODEL_ID=yolov13n-coco-640-opset18
MODEL_VERSION=1.0.0
MODEL_SHA256=f39e5a3b1763423b1e60769e81b08a5da012677dce0248f4b4a95c5ad5cb799b
MODEL_PATH=app/entry/src/main/resources/rawfile/models/yolov13n.onnx
